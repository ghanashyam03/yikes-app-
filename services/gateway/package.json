{
  "name": "@yikes/gateway",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@yikes/shared": "workspace:*",
    "dotenv": "18.0.8",
    "fastify": "5.2.1",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "20.17.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.0.5"
  }
}
